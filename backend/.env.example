# ============================================================
#  Plantilla de variables de entorno — ESTE ARCHIVO SÍ SE SUBE AL REPO
#  Copia este archivo como .env y completa los valores reales:
#    cp .env.example .env
# ============================================================

# Clave secreta de Django. Genera una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=tu-clave-secreta-aqui

# Modo debug: True para desarrollo local, False en produccion
DJANGO_DEBUG=True

# Hosts permitidos (separados por coma, sin espacios)
# Ejemplo produccion: DJANGO_ALLOWED_HOSTS=midominio.com,www.midominio.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
